# Reduced-scale stack for Deliverable 3 - single indexer, single manager,
# small instance types, still spread across 3 AZs so the HA wiring itself
# is exercised even though there's only one node per tier.
#
#   terraform apply -var-file=demo.tfvars

environment = "demo"
aws_region  = "eu-west-2"

az_count = 3
vpc_cidr = "10.0.0.0/16"

client_vpn_cidr                 = "10.100.0.0/22"
vpn_server_certificate_arn      = "arn:aws:acm:eu-west-2:ACCOUNT_ID:certificate/REPLACE-ME"
vpn_client_root_certificate_arn = "arn:aws:acm:eu-west-2:ACCOUNT_ID:certificate/REPLACE-ME"
dashboard_certificate_arn       = "arn:aws:acm:eu-west-2:ACCOUNT_ID:certificate/REPLACE-ME"

manager_node_count    = 1
manager_instance_type = "t3.medium"

indexer_node_count     = 1
indexer_instance_type  = "t3.large"
indexer_volume_size_gb = 100

dashboard_node_count    = 1
dashboard_instance_type = "t3.small"

enable_interface_endpoints = false # save ~$28/mo on a throwaway demo stack

backup_retention_days = 7
enable_backup          = false

archive_retention_days = 30

enable_dr = false # keep the demo stack single-region

log_retention_days = 30

key_pair_name = null
